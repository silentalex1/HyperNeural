{
  "name": "inferforge-web",
  "version": "0.2.0",
  "description": "Browser-based AI inference with WebLLM, Transformers.js, and WASM - no servers needed!",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "prepublishOnly": "npm run build"
