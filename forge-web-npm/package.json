    "webllm",
    "transformers",
    "inference"
  ],
  "author": "InferForge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inferforge/inferforge.git"
  },
  "peerDependencies": {
    "@mlc-ai/web-llm": "^0.2.46",
    "@xenova/transformers": "^2.17.1"
  },
  "peerDependenciesMeta": {
